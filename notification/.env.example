# RabbitMQ (in-app + email consumers in this service). Local: docker compose up -d rabbitmq
# AMQP_URL=amqp://instructor:instructor@localhost:5672/instructor
# or RABBITMQ_URL=... (alias)
# AMQP_CONSUMER_ENABLED=1

# Resend (transactional email — same service, email-service queue)
# RESEND_API_KEY=
# RESEND_FROM="Instructorebi <noreply@yourdomain.com>"
# FRONTEND_URL=http://localhost:3001

# Dedicated notification Neon (NOT the same URL as backend main DB)
DATABASE_URL=postgresql://...

# Must match main backend JWT signing secret
JWT_SECRET=

# HTTP port for this service
PORT=4002

# Comma-separated browser origins (frontend). Production (Fly secrets, -a simdrive-pro-notification):
# https://www.instructorebi.com,https://instructorebi.com,https://instructori.vercel.app
CORS_ORIGIN=http://localhost:3001

# MUST match backend NOTIFICATION_INTERNAL_SECRET exactly
NOTIFICATION_INTERNAL_SECRET=change-me-long-random
