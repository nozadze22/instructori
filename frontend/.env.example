PORT=3001
# Local dev: Nest backend. Vercel/production: public HTTPS API (not localhost).
BACKEND_URL=http://localhost:4001
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=/api
# Server-side proxy for in-app notifications (Nest notification service)
# Local: http://localhost:4002 — Vercel/prod: https://simdrive-pro-notification.fly.dev
NOTIFICATION_SERVICE_URL=http://localhost:4002
# Socket.IO (browser → notification service directly; prod: Fly URL)
NEXT_PUBLIC_NOTIFICATION_SOCKET_URL=http://localhost:4002
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Google Cloud → API key → HTTP referrers (same key as production), e.g.:
# http://localhost:3001/*  http://127.0.0.1:3001/*  https://YOUR-PROD-DOMAIN/*
