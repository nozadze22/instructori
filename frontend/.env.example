PORT=3001

# ── Local dev ──
BACKEND_URL=http://localhost:4001
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=/api
NOTIFICATION_SERVICE_URL=http://localhost:4002
NEXT_PUBLIC_NOTIFICATION_SOCKET_URL=http://localhost:4002

