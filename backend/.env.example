# Server
PORT=4000
CORS_ORIGIN="http://localhost:3001,https://simdrive-pro-web.fly.dev"

# JWT
JWT_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"

# ── Local dev (default for `pnpm start:dev` and import scripts) ──
# Pooled URL from Neon Console → Connect (host contains -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@ep-dev-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Old/backup Neon with data to copy into DATABASE_URL:
#   pnpm clone:to-dev -- --force
DEV_DATABASE_URL="postgresql://USER:PASSWORD@ep-old-dev-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
SOURCE_DATABASE_URL="postgresql://USER:PASSWORD@ep-dev-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Production (Fly secrets + `pnpm sync:to-production` target only) ──
# Do NOT point DATABASE_URL at production for everyday work — imports and
# `test:voice-drive:db` will burn Neon quota and can break the live site.
PRODUCTION_DATABASE_URL="postgresql://USER:PASSWORD@ep-prod-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional: extra host fragments treated as production (comma-separated)
# PRODUCTION_DB_HOST_MARKERS="ep-prod-xxx"

# Block `pnpm dev` if DATABASE_URL is production (recommended locally)
# BLOCK_PRODUCTION_DATABASE=1

# One-off prod script override only:
# ALLOW_PRODUCTION_DB=1

# Direct URL (no -pooler) — Prisma CLI migrate/studio only
DIRECT_URL="postgresql://USER:PASSWORD@ep-dev-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Upstash Redis (public routes catalog/detail cache)
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-me"

